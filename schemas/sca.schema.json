{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCA project configuration (.sca.json)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "ruleSets": {
      "description": "Turn whole rule sets on (true) or off (false). Everything is on by default.",
      "type": "object",
      "additionalProperties": { "type": "boolean" },
      "examples": [{ "sca-own": true, "runtime-bugfinder": true }]
    },
    "rules": {
      "description": "Single rules: true / false, or an object with enabled and severity. A rule setting wins over its rule set.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._-]*$" },
      "additionalProperties": {
        "oneOf": [
          { "type": "boolean" },
          {
            "type": "object",
            "description": "Further keys are rule parameters (e.g. a limit) for rules that have them.",
            "properties": {
              "enabled": { "type": "boolean" },
              "severity": { "enum": ["error", "warning", "info"] }
            }
          }
        ]
      }
    },
    "exclude": {
      "description": "Glob patterns (relative to this folder) that are never analyzed.",
      "type": "array",
      "items": { "type": "string" },
      "examples": [["**/generated/**"]]
    },
    "compileCommands": {
      "description": "Path of compile_commands.json, relative to this folder. Default: compile_commands.json, build/, out/ or cmake-build-debug/.",
      "type": "string"
    },
    "includePaths": {
      "description": "Extra include folders (relative to this folder), added after those from the compile database.",
      "type": "array",
      "items": { "type": "string" }
    },
    "defines": {
      "description": "Extra macros, like -D on the compiler command line.",
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "deviations": {
      "description": "Accepted findings with a reason (shown as justified).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "file", "line", "reason"],
        "properties": {
          "rule": { "type": "string", "description": "Rule ID, <ruleSet>:* or *" },
          "file": { "type": "string", "description": "Path relative to this folder" },
          "line": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "approvedBy": { "type": "string" },
          "date": { "type": "string" }
        }
      }
    },
    "metrics": {
      "description": "Limits for the his-metrics rules. A function is reported when its value is above the limit; a file when its comment density is below it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cyclomatic": { "type": "number", "minimum": 0, "default": 10, "description": "Decisions + 1 per function." },
        "nesting": { "type": "number", "minimum": 0, "default": 4, "description": "Deepest nesting of control statements." },
        "statements": { "type": "number", "minimum": 0, "default": 50, "description": "Statements per function." },
        "parameters": { "type": "number", "minimum": 0, "default": 5, "description": "Parameters per function." },
        "returns": { "type": "number", "minimum": 0, "default": 1, "description": "Return points per function." },
        "calls": { "type": "number", "minimum": 0, "default": 7, "description": "Different functions called per function." },
        "comment-density": { "type": "number", "minimum": 0, "default": 0.2, "description": "Comment lines per code line, at least." }
      }
    },
    "backends": {
      "description": "Optional external tools, run as separate processes. Their findings are merged with SCA's own. Off unless listed here.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cppcheck": { "$ref": "#/definitions/backend" },
        "clang-tidy": { "$ref": "#/definitions/backend" }
      }
    }
  },
  "definitions": {
    "backend": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "path": { "type": "string", "description": "Executable name or path. Default: found on PATH." },
            "args": { "type": "array", "items": { "type": "string" }, "description": "Extra command-line arguments." },
            "timeoutMs": { "type": "number", "minimum": 100, "default": 20000 }
          }
        }
      ]
    }
  }
}
