{
  "name": "sca",
  "displayName": "SCA - Static Code Analyzer",
  "description": "Checks C/C++ code as you write it: run-time errors and coding-rule violations.",
  "version": "0.0.1",
  "publisher": "tomasi12",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Tomasi12/sca.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sca.showInfo",
        "title": "Show Info",
        "category": "SCA"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "npm run compile && npm run lint",
    "test": "vscode-test",
    "test:unit": "npm run compile && mocha \"out/test/unit/**/*.test.js\"",
    "package": "vsce package --no-dependencies --skip-license --out sca.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^10.14.0",
    "mocha": "^12.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
