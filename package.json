{
  "name": "sca",
  "displayName": "SCA - Static Code Analyzer",
  "description": "Checks C/C++ code as you write it: run-time errors and coding-rule violations.",
  "version": "0.0.1",
  "publisher": "tomasi12",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Tomasi12/sca.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sca",
          "title": "SCA",
          "icon": "media/sca-monitor.svg"
        }
      ]
    },
    "views": {
      "sca": [
        {
          "id": "sca.issueMonitor",
          "name": "Issue Monitor",
          "contextualTitle": "SCA"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sca.issueMonitor",
        "contents": "No files are monitored yet.\nAdd C/C++ files or folders to the monitor: right-click them in the Explorer and choose \"SCA: Add to Monitor\", or add the file that is open now.\n[Add Current File](command:sca.addToMonitor)"
      }
    ],
    "commands": [
      {
        "command": "sca.showInfo",
        "title": "Show Info",
        "category": "SCA"
      },
      {
        "command": "sca.addToMonitor",
        "title": "Add to Monitor",
        "category": "SCA",
        "icon": "$(add)"
      },
      {
        "command": "sca.removeFromMonitor",
        "title": "Remove from Monitor",
        "category": "SCA",
        "icon": "$(close)"
      },
      {
        "command": "sca.clearMonitor",
        "title": "Remove All from Monitor",
        "category": "SCA",
        "icon": "$(clear-all)"
      },
      {
        "command": "sca.analyzeNow",
        "title": "Analyze Now",
        "category": "SCA",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "sca.addToMonitor",
          "when": "explorerResourceIsFolder || resourceLangId == c || resourceLangId == cpp",
          "group": "7_sca@1"
        },
        {
          "command": "sca.removeFromMonitor",
          "when": "sca.hasMonitoredEntries && (explorerResourceIsFolder || resourceLangId == c || resourceLangId == cpp)",
          "group": "7_sca@2"
        }
      ],
      "editor/context": [
        {
          "command": "sca.addToMonitor",
          "when": "resourceLangId == c || resourceLangId == cpp",
          "group": "7_sca@1"
        },
        {
          "command": "sca.removeFromMonitor",
          "when": "sca.hasMonitoredEntries && (resourceLangId == c || resourceLangId == cpp)",
          "group": "7_sca@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "sca.addToMonitor",
          "when": "resourceLangId == c || resourceLangId == cpp",
          "group": "7_sca@1"
        },
        {
          "command": "sca.removeFromMonitor",
          "when": "sca.hasMonitoredEntries && (resourceLangId == c || resourceLangId == cpp)",
          "group": "7_sca@2"
        }
      ],
      "view/title": [
        {
          "command": "sca.addToMonitor",
          "when": "view == sca.issueMonitor",
          "group": "navigation@1"
        },
        {
          "command": "sca.analyzeNow",
          "when": "view == sca.issueMonitor && sca.hasMonitoredEntries",
          "group": "navigation@2"
        },
        {
          "command": "sca.clearMonitor",
          "when": "view == sca.issueMonitor && sca.hasMonitoredEntries",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "sca.removeFromMonitor",
          "when": "view == sca.issueMonitor && viewItem == sca.monitoredFile",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "SCA",
      "properties": {
        "sca.monitor.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/third_party/**",
            "**/build/**",
            "**/out/**"
          ],
          "description": "Glob patterns skipped when a monitored folder is expanded to its C/C++ files."
        },
        "sca.analysis.runOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Analyze a monitored file every time it is saved (autosave included)."
        },
        "sca.analysis.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Wait time in milliseconds after a save before the analysis starts. A new save within this time restarts the wait."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node scripts/copy-wasm.mjs",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "npm run compile && npm run lint",
    "test": "vscode-test",
    "test:unit": "npm run compile && mocha \"out/test/unit/**/*.test.js\"",
    "package": "vsce package --skip-license --out sca.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^10.14.0",
    "mocha": "^12.0.3",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-cpp": "^0.23.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "web-tree-sitter": "^0.27.2"
  }
}
